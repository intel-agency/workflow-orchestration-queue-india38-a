# OS-APOW Environment Configuration
# Copy this file to .env and fill in your values

# GitHub Configuration (Required)
GITHUB_TOKEN=your_github_token_here
GITHUB_ORG=intel-agency
GITHUB_REPO=workflow-orchestration-queue-india38-a

# Webhook Configuration (Required for Notifier)
WEBHOOK_SECRET=your_webhook_secret_here

# Sentinel Configuration (Optional)
SENTINEL_BOT_LOGIN=
POLL_INTERVAL=60
MAX_BACKOFF=960
HEARTBEAT_INTERVAL=300
SUBPROCESS_TIMEOUT=5700

# API Keys (Optional)
ZHIPU_API_KEY=
KIMI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Configuration (comma-separated for multiple origins)
CORS_ORIGINS=["*"]
